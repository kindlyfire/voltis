{
    "name": "frontend",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "run-p type-check \"build-only {@}\" --",
        "preview": "vite preview",
        "build-only": "vite build",
        "test": "vitest run",
        "test:unit": "vitest run --project unit",
        "type-check": "vue-tsc --build",
        "format": "oxfmt --write \"src/**/*.{vue,ts}\" \"*.json\" \"*.ts\" index.html"
    },
    "dependencies": {
        "@fontsource-variable/figtree": "^5.3.0",
        "@fontsource-variable/source-serif-4": "^5.3.0",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/vue-query": "^5.102.8",
        "@unhead/vue": "^3.4.1",
        "@vueuse/core": "^14.4.0",
        "dompurify": "^3.4.15",
        "pinia": "^4.0.3",
        "reka-ui": "^2.10.5",
        "tailwindcss": "^4.3.3",
        "vue": "^3.5.42",
        "vue-router": "^5.3.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@iconify-json/material-symbols-light": "^1.2.94",
        "@tsconfig/node24": "^24.0.5",
        "@types/node": "^26.5.1",
        "@vitejs/plugin-vue": "^6.0.9",
        "@vitest/browser-playwright": "5.0.1",
        "@vitest/coverage-istanbul": "5.0.1",
        "@vue/test-utils": "^2.5.1",
        "@vue/tsconfig": "^0.9.1",
        "jsdom": "^30.1.0",
        "npm-run-all2": "^9.0.3",
        "oxfmt": "^0.68.0",
        "playwright": "^1.63.0",
        "prettier": "^3.9.6",
        "typescript": "~5.9.3",
        "unplugin-icons": "^24.0.0",
        "vite": "^8.3.0",
        "vite-plugin-vue-devtools": "^8.2.1",
        "vitest": "^5.0.1",
        "vue-tsc": "^3.3.11"
    },
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    }
}
